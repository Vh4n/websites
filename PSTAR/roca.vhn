    {
      "section_code": "4.0",
      "section_title": "Practice Exam 4",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "4.01",
          "question_text": "According to transmission of numbers, \"2,500\" feet above sea level is pronounced as:",
          "options": [
            {"id": 1, "text": "two five zero zero", "correct": false},
            {"id": 2, "text": "two thousand five zero zero", "correct": false},
            {"id": 3, "text": "two point five zero zero", "correct": false},
            {"id": 4, "text": "two thousand five hundred", "correct": true}
          ]
        },
        {
          "question_id": "4.02",
          "question_text": "What does an operator say if he/she did not understand the middle of a communication that was transmitted to him/her?",
          "options": [
            {"id": 1, "text": "SAY AGAIN ... TO ...", "correct": true},
            {"id": 2, "text": "SAY AGAIN ALL BEFORE ...", "correct": false},
            {"id": 3, "text": "SAY AGAIN ALL AFTER ...", "correct": false},
            {"id": 4, "text": "REPEAT AGAIN BETWEEN ... AND ...", "correct": false}
          ]
        },
        {
          "question_id": "4.03",
          "question_text": "In the aeronautical service, an urgency condition is a condition:",
          "options": [
            {"id": 1, "text": "Which requires the immediate intervention of TSB.", "correct": false},
            {"id": 2, "text": "Concerning the safety of an aircraft or other vehicle, or of someone on board or within sight, but which does not require immediate assistance.", "correct": true},
            {"id": 3, "text": "Of maximum priority.", "correct": false},
            {"id": 4, "text": "Of being threatened by grave and/or imminent danger and requiring immediate assistance.", "correct": false}
          ]
        },
        {
          "question_id": "4.04",
          "question_text": "In accordance with the Radiocommunication Regulations, a person may operate radio apparatus in the aeronautical service only where the person holds a Restricted Operator Certificate with Aeronautical Qualification, issued by:",
          "options": [
            {"id": 1, "text": "The Minister of Transport.", "correct": false},
            {"id": 2, "text": "Transport Canada.", "correct": false},
            {"id": 3, "text": "A flying school.", "correct": false},
            {"id": 4, "text": "Industry Canada / ISED.", "correct": true}
          ]
        },
        {
          "question_id": "4.05",
          "question_text": "When may a station interrupt or interfere with the normal working of another station?",
          "options": [
            {"id": 1, "text": "Never.", "correct": false},
            {"id": 2, "text": "When it has filled out a flight plan.", "correct": false},
            {"id": 3, "text": "When it is required to transmit a higher priority call or message.", "correct": true},
            {"id": 4, "text": "When it is about to land.", "correct": false}
          ]
        },
        {
          "question_id": "4.06",
          "question_text": "Hypothetically, What is the correct phraseology to report a bird strike to the tower?",
          "options": [
            {"id": 1, "text": "Bird strike, requesting emergency landing", "correct": true},
            {"id": 2, "text": "Bird strike, continuing as planned", "correct": false},
            {"id": 3, "text": "Bird strike, requesting taxi clearance", "correct": false},
            {"id": 4, "text": "Bird strike, requesting permission to take off", "correct": false}
          ]
        },
        {
          "question_id": "4.07",
          "question_text": "In the aeronautical service, a condition of being threatened by grave and/or imminent danger and requiring immediate assistance is a condition of:",
          "options": [
            {"id": 1, "text": "Distress.", "correct": true},
            {"id": 2, "text": "Danger.", "correct": false},
            {"id": 3, "text": "Urgency.", "correct": false},
            {"id": 4, "text": "Low priority.", "correct": false}
          ]
        },
        {
          "question_id": "4.08",
          "question_text": "What does an operator say if he/she makes an error in a transmission?",
          "options": [
            {"id": 1, "text": "I REPEAT", "correct": false},
            {"id": 2, "text": "RECTIFICATION", "correct": false},
            {"id": 3, "text": "SAY AGAIN", "correct": false},
            {"id": 4, "text": "CORRECTION", "correct": true}
          ]
        },
        {
          "question_id": "4.09",
          "question_text": "What should you do if you hear a distress message?",
          "options": [
            {"id": 1, "text": "Notify any station with direction-finding or radar facilities and request assistance, unless it is known that this action has been, or will be, taken by the station acknowledging receipt of the distress message.", "correct": false},
            {"id": 2, "text": "Continue to monitor the frequency on which the distress message was received and, if possible, establish a continuous watch on appropriate distress and emergency frequencies.", "correct": false},
            {"id": 3, "text": "Cease all transmissions that may interfere with the distress traffic.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": true}
          ]
        },
        {
          "question_id": "4.10",
          "question_text": "What should you do if you see a foreign object debris (FOD) on the runway",
          "options": [
            {"id": 1, "text": "Report the FOD to ground control immediately", "correct": true},
            {"id": 2, "text": "Ignore the FOD and continue taxiing", "correct": false},
            {"id": 3, "text": "Attempt to remove the FOD yourself", "correct": false},
            {"id": 4, "text": "Continue taxiing and report it later", "correct": false}
          ]
        },
        {
          "question_id": "4.11",
          "question_text": "When using a radio, you should:",
          "options": [
            {"id": 1, "text": "Speak very slowly to allow the receiving operator to write it down.", "correct": false},
            {"id": 2, "text": "Keep the rate of speech constant.", "correct": true},
            {"id": 3, "text": "Speak faster than usual.", "correct": false},
            {"id": 4, "text": "None of the above.", "correct": false}
          ]
        },
        {
          "question_id": "4.12",
          "question_text": "The procedural phrase ROGER means:",
          "options": [
            {"id": 1, "text": "I have received your message Number____", "correct": false},
            {"id": 2, "text": "I have received all of your last transmission.", "correct": true},
            {"id": 3, "text": "Your instructions have been received, understood and will be complied with.", "correct": false},
            {"id": 4, "text": "Authorized to proceed under the conditions specified.", "correct": false}
          ]
        },
        {
          "question_id": "4.13",
          "question_text": "Aeronautical ground station identification comprises the name of the airport or its geographical location, followed if necessary:",
          "options": [
            {"id": 1, "text": "By the hours of operation of the station.", "correct": false},
            {"id": 2, "text": "By the domain where the station is located.", "correct": false},
            {"id": 3, "text": "By the station frequency.", "correct": false},
            {"id": 4, "text": "By a suitable word indicating the function of the station.", "correct": true}
          ]
        },
        {
          "question_id": "4.14",
          "question_text": "What is a controlled aerodrome?",
          "options": [
            {"id": 1, "text": "An aerodrome at which an air traffic control unit is in operation.", "correct": true},
            {"id": 2, "text": "Any surface on which an aircraft can land.", "correct": false},
            {"id": 3, "text": "An airport.", "correct": false},
            {"id": 4, "text": "An aerodrome which has an air traffic control unit.", "correct": false}
          ]
        },
        {
          "question_id": "4.15",
          "question_text": "The first transmission of the urgency signal and message by an aircraft should be made on:",
          "options": [
            {"id": 1, "text": "The aeronautical emergency frequency (121.5 MHz).", "correct": false},
            {"id": 2, "text": "The frequency of the nearest ATC.", "correct": false},
            {"id": 3, "text": "126.7 MHz.", "correct": false},
            {"id": 4, "text": "The air-ground frequency in use at the time.", "correct": true}
          ]
        },
        {
          "question_id": "4.16",
          "question_text": "Control of distress traffic is the responsibility, if it has not been delegated, of:",
          "options": [
            {"id": 1, "text": "The air traffic control (ATC).", "correct": false},
            {"id": 2, "text": "An aeronautical station.", "correct": false},
            {"id": 3, "text": "The aircraft in distress.", "correct": true},
            {"id": 4, "text": "Search and rescue (SAR) organizations.", "correct": false}
          ]
        },
        {
          "question_id": "4.17",
          "question_text": "What is the correct procedure for crossing an active runway?",
          "options": [
            {"id": 1, "text": "Cross the runway without contacting ground control", "correct": false},
            {"id": 2, "text": "Contact ground control and request clearance to cross the runway", "correct": true},
            {"id": 3, "text": "Wait for a gap in traffic and cross the runway quickly", "correct": false},
            {"id": 4, "text": "Cross the runway only if you see no aircraft approaching", "correct": false}
          ]
        },
        {
          "question_id": "4.18",
          "question_text": "No individual shall knowingly send, transmit, or cause to be sent or transmitted any false or fraudulent distress signal, message, call or radiogram of any kind. Penalties for this offence, on summary conviction can include imprisonment for a ____ term of ____ year(s).",
          "options": [
            {"id": 1, "text": "Minimum; 1.", "correct": false},
            {"id": 2, "text": "Minimum; 3.", "correct": false},
            {"id": 3, "text": "Maximum; 3.", "correct": false},
            {"id": 4, "text": "Maximum; 1.", "correct": true}
          ]
        },
        {
          "question_id": "4.19",
          "question_text": "A person other than an individual who violates the privacy of communications is liable to a fine of----- dollars.",
          "options": [
            {"id": 1, "text": "25,000.00", "correct": false},
            {"id": 2, "text": "75,000.00", "correct": true},
            {"id": 3, "text": "5,000.00", "correct": false},
            {"id": 4, "text": "125,000.00", "correct": false}
          ]
        },
        {
          "question_id": "4.20",
          "question_text": "The call sign should be used at least:",
