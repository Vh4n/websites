    {
      "section_code": "3.0",
      "section_title": "Practice Exam 3",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "3.01",
          "question_text": "Any person having become aware of a radio communication transmitted other than by a broadcasting station or an amateur station is bound by the provisions of the Radiocommunication Act to:",
          "options": [
            {"id": 1, "text": "Not to make a tape recording of such communication.", "correct": false},
            {"id": 2, "text": "To report use of the frequency to the nearest Dept of Communications District office.", "correct": false},
            {"id": 3, "text": "To enter details of the intercept in the station log.", "correct": false},
            {"id": 4, "text": "Preserve the secrecy of correspondence.", "correct": true}
          ]
        },
        {
          "question_id": "3.02",
          "question_text": "What does the abbreviation E.L.T. represent?",
          "options": [
            {"id": 1, "text": "Emergency landing trace.", "correct": false},
            {"id": 2, "text": "Electronic levelling transceiver.", "correct": false},
            {"id": 3, "text": "Emergency locator transmitter.", "correct": true},
            {"id": 4, "text": "Elevation level trim indicator.", "correct": false}
          ]
        },
        {
          "question_id": "3.03",
          "question_text": "The procedural phrase WILCO means:",
          "options": [
            {"id": 1, "text": "The international radiotelephony urgency signal. Preferably spoken three times, it indicates a condition that concerns the safety of an aircraft or another vehicle, or some person on board or within sight, but that does not require immediate assistance.", "correct": false},
            {"id": 2, "text": "What is the readability of my transmission?", "correct": false},
            {"id": 3, "text": "I have received all of your last transmission.", "correct": false},
            {"id": 4, "text": "Your instructions have been received, understood and will be complied with.", "correct": true}
          ]
        },
        {
          "question_id": "3.04",
          "question_text": "Stations that hear the urgency signal shall continue to listen for at least ---- minute(s) on the frequency which the signal was heard.",
          "options": [
            {"id": 1, "text": "1", "correct": false},
            {"id": 2, "text": "60", "correct": false},
            {"id": 3, "text": "10", "correct": false},
            {"id": 4, "text": "3", "correct": true}
          ]
        },
        {
          "question_id": "3.05",
          "question_text": "The distress signal indicates that a person or station sending the signal:",
          "options": [
            {"id": 1, "text": "Is aware that an aircraft, ship or other vehicle is threatened by grave and imminent danger.", "correct": false},
            {"id": 2, "text": "Requires immediate assistance.", "correct": false},
            {"id": 3, "text": "Is threatened by grave and imminent danger.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": true}
          ]
        },
        {
          "question_id": "3.06",
          "question_text": "During radiocommunications, 12:45 a.m. is expressed as:",
          "options": [
            {"id": 1, "text": "0045", "correct": true},
            {"id": 2, "text": "1245", "correct": false},
            {"id": 3, "text": "2445", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": false}
          ]
        },
        {
          "question_id": "3.07",
          "question_text": "What shall you use to rebroadcast a distress message?",
          "options": [
            {"id": 1, "text": "MAYDAY RELAY (spoken once)", "correct": false},
            {"id": 2, "text": "MAYDAY RETRANS (spoken three times)", "correct": false},
            {"id": 3, "text": "MAYDAY RETRANS (spoken once)", "correct": false},
            {"id": 4, "text": "MAYDAY RELAY (spoken three times)", "correct": true}
          ]
        },
        {
          "question_id": "3.08",
          "question_text": "The urgency signal has priority over:",
          "options": [
            {"id": 1, "text": "Distress communications only.", "correct": false},
            {"id": 2, "text": "All other communications.", "correct": false},
            {"id": 3, "text": "All other communications except distress.", "correct": true},
            {"id": 4, "text": "No communication.", "correct": false}
          ]
        },
        {
          "question_id": "3.09",
          "question_text": "No individual shall knowingly send, transmit, or cause to be sent or transmitted any false or fraudulent distress signal, message, call or radiogram of any kind. Penalties for this offence, on summary conviction can include a ____ fine of _____ dollars.",
          "options": [
            {"id": 1, "text": "Maximum; 25,000.", "correct": false},
            {"id": 2, "text": "Minimum; 5,000.", "correct": false},
            {"id": 3, "text": "Maximum; 5,000.", "correct": true},
            {"id": 4, "text": "Minimum; 25,000.", "correct": false}
          ]
        },
        {
          "question_id": "3.10",
          "question_text": "According to transmission of numbers, the aerodrome elevation \"3,500\" is pronounced as:",
          "options": [
            {"id": 1, "text": "field elevation three five zero zero", "correct": false},
            {"id": 2, "text": "field elevation three thousand five zero zero", "correct": true},
            {"id": 3, "text": "field elevation three thousand five hundred", "correct": false},
            {"id": 4, "text": "three thousand five zero zero", "correct": false}
          ]
        },
        {
          "question_id": "3.11",
          "question_text": "Which of the following messages has the priority of transmission?",
          "options": [
            {"id": 1, "text": "Meteorological messages.", "correct": false},
            {"id": 2, "text": "Urgency communication.", "correct": false},
            {"id": 3, "text": "Government messages for which priority has been expressly requested.", "correct": false},
            {"id": 4, "text": "Distress communication.", "correct": true}
          ]
        },
        {
          "question_id": "3.12",
          "question_text": "On the readability scale, an unreadable signal is a ____ signal.",
          "options": [
            {"id": 1, "text": "Poor.", "correct": false},
            {"id": 2, "text": "Fair.", "correct": false},
            {"id": 3, "text": "Bad.", "correct": true},
            {"id": 4, "text": "Good.", "correct": false}
          ]
        },
        {
          "question_id": "3.13",
          "question_text": "The procedural phrase READ BACK means:",
          "options": [
            {"id": 1, "text": "Repeat all, or the specified part, of this message back to me exactly as received.", "correct": true},
            {"id": 2, "text": "An expression used in radiocommunication meaning \"I repeat for clarity or emphasis.\"", "correct": false},
            {"id": 3, "text": "An expression used to request a repetition of the last transmission.", "correct": false},
            {"id": 4, "text": "Authorized to proceed under the conditions specified.", "correct": false}
          ]
        },
        {
          "question_id": "3.14",
          "question_text": "You want to transmit a message on a frequency. How should you proceed?",
          "options": [
            {"id": 1, "text": "Set the frequency, ask for a radio check and talk.", "correct": false},
            {"id": 2, "text": "Set the frequency and listen to it for an appropriate period of time.", "correct": true},
            {"id": 3, "text": "Set the frequency and talk without waiting.", "correct": false},
            {"id": 4, "text": "Set the frequency, ensure it is the correct one and talk without waiting.", "correct": false}
          ]
        },
        {
          "question_id": "3.15",
          "question_text": "How should the acknowledgment of receipt of a distress message be given?",
          "options": [
            {"id": 1, "text": "The distress signal \"MAYDAY\", the call sign of the station in distress (spoken once), the words \"THIS IS\", the call sign of the station acknowledging receipt (spoken once), the words \"RECEIVED MAYDAY\".", "correct": false},
            {"id": 2, "text": "The call sign of the station in distress (spoken once), the words \"THIS IS\", the call sign of the station acknowledging receipt (spoken once), the words \"RECEIVED MAYDAY\".", "correct": false},
            {"id": 3, "text": "The call sign of the station in distress (spoken three times), the words \"THIS IS\", the call sign of the station acknowledging receipt (spoken three times), the words \"RECEIVED MAYDAY\".", "correct": false},
            {"id": 4, "text": "The distress signal \"MAYDAY\", the call sign of the station in distress (spoken three times), the words \"THIS IS\", the call sign of the station acknowledging receipt (spoken three times), the words \"RECEIVED MAYDAY\".", "correct": true}
          ]
        },
        {
          "question_id": "3.16",
          "question_text": "In the ITU phonetic alphabet, \"G\" is pronounced as (syllables to be emphasized are in capital letters):",
          "options": [
            {"id": 1, "text": "go LF", "correct": false},
            {"id": 2, "text": "golf", "correct": true},
            {"id": 3, "text": "GOH OLF", "correct": false},
            {"id": 4, "text": "GO LF", "correct": false}
          ]
        },
        {
          "question_id": "3.17",
          "question_text": "The message handling format generally consists of four parts:",
          "options": [
            {"id": 1, "text": "The call indicating the addressee and the originator, the addressee reply, the message, the acknowledgment or ending.", "correct": true},
            {"id": 2, "text": "The initial contact, the location, the message, the ending.", "correct": false},
            {"id": 3, "text": "The call indicating the addressee and the originator, the message, the addressee reply, the acknowledgment or ending.", "correct": false},
            {"id": 4, "text": "The initial contact, the current hour, the location, the message.", "correct": false}
          ]
        },
        {
          "question_id": "3.18",
          "question_text": "What phrase should you use when you receive all of your last transmission?",
