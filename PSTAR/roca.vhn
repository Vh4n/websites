          ]
        },
        {
          "question_id": "6.23",
          "question_text": "The figures $300.27 would be transmitted as:",
          "options": [
            {"id": 1, "text": "Three hundred dollars twenty seven.", "correct": false},
            {"id": 2, "text": "Three hundred and twenty seven dollars.", "correct": false},
            {"id": 3, "text": "Dollars three hundred twenty seven.", "correct": false},
            {"id": 4, "text": "Dollars three zero zero decimal two seven.", "correct": true}
          ]
        },
        {
          "question_id": "6.24",
          "question_text": "What would a readability of 1 mean?",
          "options": [
            {"id": 1, "text": "Good (or readable).", "correct": false},
            {"id": 2, "text": "Poor (or readable now and then).", "correct": false},
            {"id": 3, "text": "Bad (or Unreadable).", "correct": true},
            {"id": 4, "text": "Excellent (or perfectly intelligible).", "correct": false}
          ]
        },
        {
          "question_id": "6.25",
