            {"id": 2, "text": "Requesting taxi clearance to runway", "correct": true},
            {"id": 3, "text": "Taxiing to runway", "correct": false},
            {"id": 4, "text": "Requesting permission to land", "correct": false}
          ]
        },
        {
          "question_id": "4.23",
          "question_text": "Who should cancel an urgency message?",
