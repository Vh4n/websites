            {"id": 3, "text": "426.0.", "correct": false},
            {"id": 4, "text": "121.5.", "correct": false}
          ]
        },
        {
          "question_id": "4.25",
          "question_text": "According to transmission of numbers, \"75\" is pronounced as:",
          "options": [
            {"id": 1, "text": "seventy-five", "correct": false},
            {"id": 2, "text": "seven five", "correct": true},
            {"id": 3, "text": "seven plus five", "correct": false},
