            {"id": 2, "text": "ROGER", "correct": true},
            {"id": 3, "text": "OK", "correct": false},
            {"id": 4, "text": "TEN-FOUR", "correct": false}
          ]
        },
        {
          "question_id": "3.19",
          "question_text": "No corporation shall knowingly send, transmit, or cause to be sent or transmitted any false or fraudulent distress signal, message, call or radiogram of any kind. Penalties for this offence, on summary conviction can include a ---- fine of ---- dollars.",
          "options": [
            {"id": 1, "text": "Minimum; 15,000.", "correct": false},
            {"id": 2, "text": "Maximum; 15,000.", "correct": false},
            {"id": 3, "text": "Maximum; 25,000.", "correct": true},
            {"id": 4, "text": "Minimum; 25,000.", "correct": false}
          ]
        },
        {
          "question_id": "3.20",
          "question_text": "In communications between aeronautical ground stations and aircraft stations, the ___ station shall comply with instructions given by the ___ station in all matters relating to the order and time of transmission, the choice of frequency and the duration and suspension of communications.",
          "options": [
            {"id": 1, "text": "Transmitting; receiving.", "correct": false},
            {"id": 2, "text": "Ground; aircraft.", "correct": false},
            {"id": 3, "text": "Aircraft; ground.", "correct": true},
            {"id": 4, "text": "Certified; non-certified.", "correct": false}
          ]
        },
        {
          "question_id": "3.21",
          "question_text": "What is a call sign?",
          "options": [
            {"id": 1, "text": "A way to identify a radio station.", "correct": true},
            {"id": 2, "text": "A sign chosen by the control tower when it wants to contact you.", "correct": false},
