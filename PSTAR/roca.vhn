{
  "sections": [
    {
      "section_code": "1.0",
      "section_title": "Practice Exam 1",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "1.01",
          "question_text": "Prohibited messages or transmissions are:",
          "options": [
            {"id": 1, "text": "Messages of a personal nature to an addressee.", "correct": false},
            {"id": 2, "text": "A transmission with encrypted groups.", "correct": false},
            {"id": 3, "text": "Mixed plain language and coded groups.", "correct": false},
            {"id": 4, "text": "False distress signals, profane language, and superfluous communications.", "correct": true}
          ]
        },
        {
          "question_id": "1.02",
          "question_text": "What is the correct order of priority for transmitting messages in the aeronautical service?",
          "options": [
            {"id": 1, "text": "Meteorological messages; Flight safety messages; Distress communications; Urgency communications; Communications relating to radio direction-finding", "correct": false},
            {"id": 2, "text": "Distress communications; Urgency communications; Communications relating to radio direction-finding; Flight safety messages; Meteorological messages", "correct": true},
            {"id": 3, "text": "Communications relating to radio direction-finding; Meteorological messages; Urgency communications; Flight safety messages; Distress communications", "correct": false},
            {"id": 4, "text": "Flight safety messages; Communications relating to radio direction-finding; Meteorological messages; Distress communications; Urgency communications", "correct": false}
          ]
        },
        {
          "question_id": "1.03",
          "question_text": "In the ITU phonetic alphabet, \"A\" is pronounced as (syllables to be emphasized are in capital letters):",
          "options": [
            {"id": 1, "text": "AL fah", "correct": false},
            {"id": 2, "text": "AL FAH", "correct": true},
            {"id": 3, "text": "al FAH", "correct": false},
            {"id": 4, "text": "al fah", "correct": false}
          ]
        },
        {
          "question_id": "1.04",
          "question_text": "In radiotelephony, the spoken word for distress is:",
          "options": [
            {"id": 1, "text": "RESCUE", "correct": false},
            {"id": 2, "text": "MAYDAY", "correct": true},
            {"id": 3, "text": "PAN PAN", "correct": false},
            {"id": 4, "text": "HELP", "correct": false}
          ]
        },
        {
          "question_id": "1.05",
          "question_text": "An aircraft in distress shall turn its ELT on:",
          "options": [
            {"id": 1, "text": "Just after landing.", "correct": false},
            {"id": 2, "text": "Before transmitting its distress message.", "correct": false},
            {"id": 3, "text": "Just before landing.", "correct": false},
            {"id": 4, "text": "When appropriate.", "correct": true}
          ]
        },
        {
          "question_id": "1.06",
          "question_text": "Before talking on the radio, you should",
          "options": [
            {"id": 1, "text": "Ensure you are on the correct frequency,", "correct": false},
            {"id": 2, "text": "Ensure the frequency is clear.", "correct": false},
            {"id": 3, "text": "Know what you want to say before you transmit.", "correct": false},
            {"id": 4, "text": "All are correct.", "correct": true}
          ]
        },
        {
          "question_id": "1.07",
          "question_text": "The station in distress, or the station in control of distress traffic, may impose silence on all stations in the area or on any station that interferes with the distress traffic. The station in distress, or the station in control, shall use the expression:",
          "options": [
            {"id": 1, "text": "SEELONCE URGENCY", "correct": false},
            {"id": 2, "text": "SEELONCE DISTRESS", "correct": false},
            {"id": 3, "text": "SEELONCE IMPOSED", "correct": false},
            {"id": 4, "text": "SEELONCE MAYDAY", "correct": true}
          ]
        },
        {
          "question_id": "1.08",
          "question_text": "Signal checks should:",
          "options": [
            {"id": 1, "text": "Not last more than 10 seconds.", "correct": true},
            {"id": 2, "text": "Be exchanged on channel 16.", "correct": false},
            {"id": 3, "text": "Last as long as the operator wishes.", "correct": false},
            {"id": 4, "text": "Be exchanged on channel 16 and last as long as the operator wishes.", "correct": false}
          ]
        },
        {
          "question_id": "1.09",
          "question_text": "According to transmission of numbers, \"68,009\" is pronounced as:",
          "options": [
            {"id": 1, "text": "six eight zero zero nine", "correct": true},
            {"id": 2, "text": "sixty eight zero zero nine", "correct": false},
            {"id": 3, "text": "six eight thousand nine", "correct": false},
            {"id": 4, "text": "six eight thousand zero zero nine", "correct": false}
          ]
        },
        {
          "question_id": "1.10",
          "question_text": "According to transmission of numbers, \"C-150\" aircraft is pronounced as:",
          "options": [
            {"id": 1, "text": "charlie one fifty", "correct": false},
            {"id": 2, "text": "c fifteen zero", "correct": false},
            {"id": 3, "text": "charlie one five zero", "correct": false},
            {"id": 4, "text": "c one fifty", "correct": true}
          ]
        },
        {
          "question_id": "1.11",
          "question_text": "In the ITU phonetic alphabet, \"N\" is pronounced as (syllables to be emphasized are in capital letters):",
          "options": [
            {"id": 1, "text": "NO VEM BER", "correct": true},
            {"id": 2, "text": "NO vem BER", "correct": false},
            {"id": 3, "text": "no VEM ber", "correct": false},
            {"id": 4, "text": "no VEM BER", "correct": false}
          ]
        },
        {
          "question_id": "1.12",
          "question_text": "When station operators hear a call but are not sure of the identity of the calling station, they should reply immediately using the words:",
          "options": [
            {"id": 1, "text": "The called station's identification, and the words \"SAY AGAIN\" or \"OVER\".", "correct": false},
            {"id": 2, "text": "\"STATION CALLING\", the called station's identification, and the word \"OVER\".", "correct": false},
            {"id": 3, "text": "\"STATION CALLING\", the called station's identification, and the words \"SAY AGAIN\" and \"OVER\".", "correct": true},
            {"id": 4, "text": "\"STATION CALLING\", the called station's identification, and the words \"SAY AGAIN\".", "correct": false}
          ]
        },
        {
          "question_id": "1.13",
          "question_text": "When using a radio, you should:",
          "options": [
            {"id": 1, "text": "Speak more slowly than usual.", "correct": false},
            {"id": 2, "text": "Preserve the rhythm of ordinary conversation.", "correct": true},
            {"id": 3, "text": "Run words together.", "correct": false},
            {"id": 4, "text": "Speak faster than usual.", "correct": false}
          ]
        },
        {
          "question_id": "1.14",
          "question_text": "The proper method to acknowledge the receipt of a distress message from aircraft C-FADA is: (assuming your station is C-FBRD)",
          "options": [
            {"id": 1, "text": "Mayday, C-FBRD C-FBRD C-FBRD, Received Mayday.", "correct": false},
            {"id": 2, "text": "Mayday, Mayday, Mayday, this is C-FBRD C-FBRD C-FBRD, Silence Mayday.", "correct": false},
            {"id": 3, "text": "Mayday, C-FADA C-FADA C-FADA, this is C-FBRD C-FBRD C-FBRD, Received Mayday.", "correct": true},
            {"id": 4, "text": "Mayday, C-FADA C-FADA C-FADA, this is C-FBRD C-FBRD C-FBRD, Mayday Relay.", "correct": false}
          ]
        },
        {
          "question_id": "1.15",
          "question_text": "The station acknowledging an urgency message shall forward the urgency information to the appropriate authorities. That means:",
          "options": [
            {"id": 1, "text": "An airport operating agency.", "correct": false},
            {"id": 2, "text": "The representative of an airport operating agency.", "correct": false},
            {"id": 3, "text": "An air traffic service unit.", "correct": false},
            {"id": 4, "text": "All of the above", "correct": true}
          ]
        },
        {
          "question_id": "1.16",
          "question_text": "Which of the following expressions follows proper radiotelephone procedures?",
          "options": [
            {"id": 1, "text": "Over and out.", "correct": false},
            {"id": 2, "text": "Repeat, over.", "correct": false},
            {"id": 3, "text": "Affirmative, over.", "correct": true},
            {"id": 4, "text": "Can you say again? Out.", "correct": false}
          ]
        },
        {
          "question_id": "1.17",
          "question_text": "In the ITU phonetic alphabet, \"9\" is pronounced as:",
          "options": [
            {"id": 1, "text": "nin-ER", "correct": false},
            {"id": 2, "text": "NIN-er", "correct": true},
            {"id": 3, "text": "nin-E", "correct": false},
            {"id": 4, "text": "NIN-e", "correct": false}
          ]
        },
        {
          "question_id": "1.18",
          "question_text": "The operation of an aircraft station is under the control of:",
          "options": [
            {"id": 1, "text": "The pilot.", "correct": true},
            {"id": 2, "text": "The station manufacturer.", "correct": false},
            {"id": 3, "text": "The aircraft manufacturer.", "correct": false},
            {"id": 4, "text": "The school that rents the aircraft.", "correct": false}
          ]
        },
        {
          "question_id": "1.19",
          "question_text": "Any person who violates the regulations relative to unauthorized communications, profane or obscene language is liable, on summary conviction, in the case of an individual, to a — fine of — dollars.",
          "options": [
            {"id": 1, "text": "Maximum; 5,000.", "correct": true},
            {"id": 2, "text": "Minimum; 25,000.", "correct": false},
            {"id": 3, "text": "Maximum; 25,000.", "correct": false},
            {"id": 4, "text": "Minimum; 5,000.", "correct": false}
          ]
        },
        {
          "question_id": "1.20",
          "question_text": "According to transmission of numbers, the heading \"240\" is pronounced as:",
          "options": [
            {"id": 1, "text": "heading two forty", "correct": false},
            {"id": 2, "text": "heading twenty four zero", "correct": false},
            {"id": 3, "text": "heading two four zero", "correct": true},
            {"id": 4, "text": "heading two four", "correct": false}
          ]
        },
        {
          "question_id": "1.21",
          "question_text": "The call sign used to identify a land station is:",
          "options": [
            {"id": 1, "text": "The name of your company.", "correct": false},
            {"id": 2, "text": "Whatever name or number is convenient.", "correct": false},
            {"id": 3, "text": "Assigned by Industry Canada.", "correct": true},
            {"id": 4, "text": "The name of the person operating the station.", "correct": false}
          ]
        },
        {
          "question_id": "1.22",
          "question_text": "To whom should the cancellation message of an urgency message be addressed?",
          "options": [
            {"id": 1, "text": "To all stations.", "correct": true},
            {"id": 2, "text": "To the SAR.", "correct": false},
            {"id": 3, "text": "To Quebec Radio.", "correct": false},
            {"id": 4, "text": "To the ATC.", "correct": false}
          ]
        },
        {
          "question_id": "1.23",
          "question_text": "The procedural phrase BREAK means:",
          "options": [
            {"id": 1, "text": "Separation between portions of the message.", "correct": true},
            {"id": 2, "text": "Authorized to proceed under the conditions specified.", "correct": false},
            {"id": 3, "text": "Your instructions have been received, understood and will be complied with.", "correct": false},
            {"id": 4, "text": "I must pause for a few seconds or minutes. Please wait and I will call you.", "correct": false}
          ]
        },
        {
          "question_id": "1.24",
          "question_text": "How would you ensure that search and rescue stations are informed that a station is no longer in distress?",
          "options": [
            {"id": 1, "text": "It is automatically done by SAR.", "correct": false},
            {"id": 2, "text": "By calling 911.", "correct": false},
            {"id": 3, "text": "With a normal call to the nearest aeronautical station detailing the reasons for cancelling the distress call.", "correct": true},
            {"id": 4, "text": "With a cancellation of distress (SEELONCE FEENEE).", "correct": false}
          ]
        },
        {
          "question_id": "1.25",
          "question_text": "Who issues Radio station licences in Canada?",
          "options": [
            {"id": 1, "text": "Transport Canada.", "correct": false},
            {"id": 2, "text": "The Canadian Radio Television and Commission (CRTC).", "correct": false},
            {"id": 3, "text": "Canada Post.", "correct": false},
            {"id": 4, "text": "Industry Canada.", "correct": true}
          ]
        }
      ]
    },
    {
      "section_code": "2.0",
      "section_title": "Practice Exam 2",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "2.01",
          "question_text": "Which clock system should be used to express time during radiocommunications, and how should time be transmitted?",
          "options": [
            {"id": 1, "text": "12-hour clock; 3 figures", "correct": false},
            {"id": 2, "text": "24-hour clock; 4 figures", "correct": true},
            {"id": 3, "text": "24-hour clock; 2 figures", "correct": false},
            {"id": 4, "text": "12-hour clock; 2 figures", "correct": false}
          ]
        },
        {
          "question_id": "2.02",
          "question_text": "On the readability scale, a fair signal is a signal that is:",
          "options": [
            {"id": 1, "text": "Readable but with difficulty.", "correct": true},
            {"id": 2, "text": "Unreadable.", "correct": false},
            {"id": 3, "text": "Readable.", "correct": false},
            {"id": 4, "text": "Readable now and then.", "correct": false}
          ]
        },
        {
          "question_id": "2.03",
          "question_text": "The maximum penalty for an individual establishing a radio station without a radio licence is:",
          "options": [
            {"id": 1, "text": "There is no fine if they apologise.", "correct": false},
            {"id": 2, "text": "$500 fine and 6 months imprisonment.", "correct": false},
            {"id": 3, "text": "$5,000 fine and up to 6 months imprisonment.", "correct": false},
            {"id": 4, "text": "$5,000 fine and up to 12 months imprisonment.", "correct": true}
          ]
        },
        {
          "question_id": "2.04",
          "question_text": "In communications between aircraft stations, the aircraft station ---- is the controlling station.",
          "options": [
            {"id": 1, "text": "Which is calling.", "correct": false},
            {"id": 2, "text": "Being called.", "correct": true},
            {"id": 3, "text": "Which is higher.", "correct": false},
            {"id": 4, "text": "Which is landing.", "correct": false}
          ]
        },
        {
          "question_id": "2.05",
          "question_text": "The order of priority for transmission in the aeronautical service is:",
          "options": [
            {"id": 1, "text": "Distress, urgency and communications relating to radio direction finding.", "correct": true},
            {"id": 2, "text": "Distress, flight safety and weather warnings.", "correct": false},
            {"id": 3, "text": "Distress, urgency and flight safety.", "correct": false},
            {"id": 4, "text": "Distress, urgency and safety communication.", "correct": false}
          ]
        },
        {
          "question_id": "2.06",
          "question_text": "The distress call shall be addressed to:",
          "options": [
            {"id": 1, "text": "SAR.", "correct": false},
            {"id": 2, "text": "No particular station.", "correct": true},
            {"id": 3, "text": "Quebec Radio.", "correct": false},
            {"id": 4, "text": "ATC.", "correct": false}
          ]
        },
        {
          "question_id": "2.07",
          "question_text": "Which of the following distress calls is correct?",
          "options": [
            {"id": 1, "text": "\"MAYDAY MESSAGE THIS IS CESSNA FOXTROT X-RAY CHARLIE CHARLIE CESSNA FOXTROT X-RAY CHARLIE CHARLIE CESSNA FOXTROT X-RAY CHARLIE CHARLIE\"", "correct": false},
            {"id": 2, "text": "\"MAYDAY, MAYDAY, MAYDAY THIS IS CESSNA FOXTROT X-RAY CHARLIE CHARLIE CESSNA FOXTROT X-RAY CHARLIE CHARLIE CESSNA FOXTROT X-RAY CHARLIE CHARLIE\"", "correct": true},
            {"id": 3, "text": "\"MAYDAY, MAYDAY, MAYDAY THIS IS CESSNA FOXTROT X-RAY CHARLIE CHARLIE\"", "correct": false},
            {"id": 4, "text": "\"MAYDAY, MAYDAY THIS IS CESSNA FOXTROT X-RAY CHARLIE CHARLIE CESSNA FOXTROT X-RAY CHARLIE CHARLIE\"", "correct": false}
          ]
        },
        {
          "question_id": "2.08",
          "question_text": "The signal \"MAYDAY\" indicates:",
          "options": [
            {"id": 1, "text": "An urgency situation.", "correct": false},
            {"id": 2, "text": "A safety message will follow.", "correct": false},
            {"id": 3, "text": "Normal communications can resume on a restricted basis.", "correct": false},
            {"id": 4, "text": "A distress situation.", "correct": true}
          ]
        },
        {
          "question_id": "2.09",
          "question_text": "In order for your communication to be perfectly readable, the microphone of your headset should be:",
          "options": [
            {"id": 1, "text": "At 1 inch from your mouth.", "correct": true},
            {"id": 2, "text": "At 10 centimeters from your mouth.", "correct": false},
            {"id": 3, "text": "As far as possible from your mouth.", "correct": false},
            {"id": 4, "text": "In direct contact with your lips.", "correct": false}
          ]
        },
        {
          "question_id": "2.10",
          "question_text": "According to transmission of numbers, \"$0.75\" is pronounced as:",
          "options": [
            {"id": 1, "text": "zero decimal seven five", "correct": false},
            {"id": 2, "text": "point seven five", "correct": false},
            {"id": 3, "text": "decimal seven five", "correct": true},
            {"id": 4, "text": "zero point seven five", "correct": false}
          ]
        },
        {
          "question_id": "2.11",
          "question_text": "The figures $300.27 would be transmitted as:",
          "options": [
            {"id": 1, "text": "Three hundred dollars twenty seven.", "correct": false},
            {"id": 2, "text": "Three hundred and twenty seven dollars.", "correct": false},
            {"id": 3, "text": "Dollars three hundred twenty seven.", "correct": false},
            {"id": 4, "text": "Dollars three zero zero decimal two seven.", "correct": true}
          ]
        },
        {
          "question_id": "2.12",
          "question_text": "Stations near the station in distress may impose silence during a distress situation by using the international expression:",
          "options": [
            {"id": 1, "text": "SEELONCE DISTRESS", "correct": true},
            {"id": 2, "text": "SEELONCE MAYDAY", "correct": false},
            {"id": 3, "text": "SEELONCE IMPOSED", "correct": false},
            {"id": 4, "text": "SEELONCE URGENCY", "correct": false}
          ]
        },
        {
          "question_id": "2.13",
          "question_text": "Noon (EST) of the 16th day of the month is expressed as:",
          "options": [
            {"id": 1, "text": "121600 E.", "correct": false},
            {"id": 2, "text": "120000 E.", "correct": false},
            {"id": 3, "text": "161200 E.", "correct": true},
            {"id": 4, "text": "160000 E.", "correct": false}
          ]
        },
        {
          "question_id": "2.14",
          "question_text": "Restricted Operator Certificate with Aeronautical Qualification (ROC-A) is obtained by:",
          "options": [
            {"id": 1, "text": "Paying an annual fee.", "correct": false},
            {"id": 2, "text": "Demonstrating competence through testing.", "correct": true},
            {"id": 3, "text": "Installing type approved equipment on board.", "correct": false},
            {"id": 4, "text": "Licensing your radio station.", "correct": false}
          ]
        },
        {
          "question_id": "2.15",
          "question_text": "What should a distress message include?",
          "options": [
            {"id": 1, "text": "MAYDAY signal; call sign; nature of distress; intentions; position; persons on board; other information; call sign", "correct": true},
            {"id": 2, "text": "MAYDAY signal; call sign; nature of distress; intentions; position; persons on board; other information; weather conditions", "correct": false},
            {"id": 3, "text": "MAYDAY signal; call sign; nature of distress; intentions; position; persons on board; other information; flight number", "correct": false},
            {"id": 4, "text": "MAYDAY signal; call sign; nature of distress; intentions; position; persons on board; other information; aircraft type", "correct": false}
          ]
        },
        {
          "question_id": "2.16",
          "question_text": "When station operators hear a call but are uncertain that the call is intended for their station:",
          "options": [
            {"id": 1, "text": "They should answer the call as it was for them.", "correct": false},
            {"id": 2, "text": "They should ask the transmitting station to repeat the call.", "correct": false},
            {"id": 3, "text": "They should not reply until the call has been repeated and understood.", "correct": true},
            {"id": 4, "text": "None of the above.", "correct": false}
          ]
        },
        {
          "question_id": "2.17",
          "question_text": "To terminate a communication, conclude the transmission with:",
          "options": [
            {"id": 1, "text": "OVER", "correct": false},
            {"id": 2, "text": "BREAK", "correct": false},
            {"id": 3, "text": "END", "correct": false},
            {"id": 4, "text": "OUT", "correct": true}
          ]
        },
        {
          "question_id": "2.18",
          "question_text": "In the case of normal communications between a base station and an aircraft station:",
          "options": [
            {"id": 1, "text": "The aircraft station cannot call the base station first.", "correct": false},
            {"id": 2, "text": "The aircraft station has control of communications.", "correct": false},
            {"id": 3, "text": "Whichever station called first has control of communications.", "correct": false},
            {"id": 4, "text": "The base station has control of communications.", "correct": true}
          ]
        },
        {
          "question_id": "2.19",
          "question_text": "The time of 1:30 A.M. expressed in the 24-hour system would be:",
          "options": [
            {"id": 1, "text": "Zero one three zero hours.", "correct": true},
            {"id": 2, "text": "One three three zero hours.", "correct": false},
            {"id": 3, "text": "Thirteen thirty hours.", "correct": false},
            {"id": 4, "text": "Zero one thirty hours.", "correct": false}
          ]
        },
        {
          "question_id": "2.20",
          "question_text": "The frequency 156.8 MHz would be spoken:",
          "options": [
            {"id": 1, "text": "One fifty six point eight.", "correct": false},
            {"id": 2, "text": "One fifty six eight.", "correct": false},
            {"id": 3, "text": "One five six eight.", "correct": false},
            {"id": 4, "text": "One five six decimal eight.", "correct": true}
          ]
        },
        {
          "question_id": "2.21",
          "question_text": "A message to cancel a distress should be addressed to:",
          "options": [
            {"id": 1, "text": "A specific station in close vicinity.", "correct": false},
            {"id": 2, "text": "All stations.", "correct": true},
            {"id": 3, "text": "Ground control stations.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": false}
          ]
        },
        {
          "question_id": "2.22",
          "question_text": "When an aeronautical ground station receives calls from several aircraft stations at approximately the same time, it decides the order in which these stations may transmit their traffic depending on:",
          "options": [
            {"id": 1, "text": "The proximity of the aircraft in relation to the center of the ground station.", "correct": false},
            {"id": 2, "text": "The aircraft length.", "correct": false},
            {"id": 3, "text": "The priority status of the messages.", "correct": true},
            {"id": 4, "text": "None of the above.", "correct": false}
          ]
        },
        {
          "question_id": "2.23",
          "question_text": "To avoid confusion between different time zones, time is usually referenced to one standard time zone:",
          "options": [
            {"id": 1, "text": "Greenland Mean Time (GMT).", "correct": false},
            {"id": 2, "text": "ZUZU Time (Z).", "correct": false},
            {"id": 3, "text": "The coordinated universal time.", "correct": true},
            {"id": 4, "text": "The coordinated local time.", "correct": false}
          ]
        },
        {
          "question_id": "2.24",
          "question_text": "To transmit an urgency signal, you have to repeat ——- time(s) the word(s) ———",
          "options": [
            {"id": 1, "text": "3; PAN PAN", "correct": true},
            {"id": 2, "text": "3; PAN.", "correct": false},
            {"id": 3, "text": "3; MAYDAY", "correct": false},
            {"id": 4, "text": "1; MAYDAY.", "correct": false}
          ]
        },
        {
          "question_id": "2.25",
          "question_text": "According to transmission of numbers, a wind of \"240/10\" is pronounced as:",
          "options": [
            {"id": 1, "text": "wind two forty degrees one zero knots", "correct": false},
