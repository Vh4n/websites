    {
      "section_code": "5.0",
      "section_title": "Practice Exam 5",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "5.01",
          "question_text": "A penalty not exceeding five thousand dollars ($5,000) and costs and/or imprisonment for twelve months is provided for:",
          "options": [
            {"id": 1, "text": "Doing radio checks.", "correct": false},
            {"id": 2, "text": "Using the \"10\" code.", "correct": false},
            {"id": 3, "text": "Not having a radio log", "correct": false},
            {"id": 4, "text": "An individual transmitting a false or fraudulent distress signal.", "correct": true}
          ]
        },
        {
          "question_id": "5.02",
          "question_text": "An aircraft station that is not in distress should transmit the distress message when:",
          "options": [
            {"id": 1, "text": "The station in distress is not in a position to transmit the message.", "correct": false},
            {"id": 2, "text": "Although not in a position to offer assistance, the aircraft station has heard a distress message which has not been acknowledged.", "correct": false},
            {"id": 3, "text": "The person in command of the station not in distress believes that further help is necessary.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": true}
          ]
        },
        {
          "question_id": "5.03",
          "question_text": "Call Signs should be sent:",
          "options": [
            {"id": 1, "text": "At least on the initial call and when communication is being concluded.", "correct": true},
            {"id": 2, "text": "Only once during the call.", "correct": false},
            {"id": 3, "text": "As often as necessary until a reply is received.", "correct": false},
            {"id": 4, "text": "As quickly as possible to save air time.", "correct": false}
          ]
        },
        {
          "question_id": "5.04",
          "question_text": "What special care should be observed when handling and using a microphone?",
          "options": [
            {"id": 1, "text": "Keep the microphone at the recommended distance as suggested by the operational manual.", "correct": true},
            {"id": 2, "text": "Keep the microphone very close to your mouth.", "correct": false},
            {"id": 3, "text": "Keep the microphone at least 20 cm from your mouth.", "correct": false},
            {"id": 4, "text": "Talk slowly.", "correct": false}
          ]
        },
        {
          "question_id": "5.05",
          "question_text": "The International VHF aeronautical air-ground distress frequency is:",
          "options": [
            {"id": 1, "text": "121.5 MHz.", "correct": true},
            {"id": 2, "text": "122.2 MHz.", "correct": false},
            {"id": 3, "text": "121.9 MHz.", "correct": false},
            {"id": 4, "text": "156.8 MHz.", "correct": false}
          ]
        },
        {
          "question_id": "5.06",
          "question_text": "In the ITU phonetic alphabet, \"U\" is pronounced as (syllables to be emphasized are in capital letters):",
          "options": [
            {"id": 1, "text": "YOU nee form", "correct": true},
            {"id": 2, "text": "you NEE FORM", "correct": false},
            {"id": 3, "text": "you nee FORM", "correct": false},
            {"id": 4, "text": "None of the above.", "correct": false}
          ]
        },
        {
          "question_id": "5.07",
          "question_text": "Any station that has heard an unacknowledged distress message:",
          "options": [
            {"id": 1, "text": "Must change frequency.", "correct": false},
            {"id": 2, "text": "Must do anything to assist the station in distress.", "correct": false},
            {"id": 3, "text": "Must do nothing if it is not in a position to lend assistance.", "correct": false},
            {"id": 4, "text": "Shall take all possible steps to attract the attention of other stations that are in a position to assist.", "correct": true}
          ]
        },
        {
          "question_id": "5.08",
          "question_text": "According to transmission of numbers, a ceiling of \"28BKN\" is pronounced as:",
          "options": [
            {"id": 1, "text": "two eight hundred broken", "correct": true},
            {"id": 2, "text": "two eight thousand broken", "correct": false},
            {"id": 3, "text": "twenty eight hundred broken", "correct": false},
            {"id": 4, "text": "twenty eight thousand broken", "correct": false}
          ]
        },
        {
          "question_id": "5.09",
          "question_text": "Any person who violates the regulations relative to unauthorized communications, profane or obscene language is liable, on summary conviction, in the case of a corporation, to a ---- fine of ---- dollars .",
          "options": [
            {"id": 1, "text": "Maximum; 25,000.", "correct": true},
            {"id": 2, "text": "Minimum; 25,000.", "correct": false},
            {"id": 3, "text": "Minimum; 15,000.", "correct": false},
            {"id": 4, "text": "Maximum; 15,000.", "correct": false}
          ]
        },
        {
          "question_id": "5.10",
          "question_text": "Radiocommunications between aeronautical stations should be restricted to those relating to safety and flight regularity. In accordance with subsection 32(1) of the Radiocommunication Regulations, superfluous communication, as well as profane and obscene language, is:",
          "options": [
            {"id": 1, "text": "Prohibited inside controlled airspaces.", "correct": false},
            {"id": 2, "text": "Strictly prohibited.", "correct": true},
            {"id": 3, "text": "Allowed on private frequencies.", "correct": false},
            {"id": 4, "text": "To be minimized.", "correct": false}
          ]
        },
        {
          "question_id": "5.11",
          "question_text": "In communications between an aeronautical ground station and an aircraft station in distress, the — station shal comply with instructions given by the — station in all matters relating to the order and time of transmission, the choice of frequency and the duration and suspension of communications.",
          "options": [
            {"id": 1, "text": "Certified; non-certified.", "correct": false},
            {"id": 2, "text": "Aircraft; ground.", "correct": false},
            {"id": 3, "text": "Transmitting; receiving.", "correct": false},
            {"id": 4, "text": "Ground; aircraft.", "correct": true}
          ]
        },
        {
          "question_id": "5.12",
          "question_text": "Stations acknowledging receipt of a distress message must:",
          "options": [
            {"id": 1, "text": "Take immediate action to ensure that all necessary information is provided as soon as possible to the Air Traffic Service (ATS) unit concerned, and the aircraft operating agency concerned (or its representative).", "correct": true},
            {"id": 2, "text": "Not interact with the other stations on the frequency.", "correct": false},
            {"id": 3, "text": "Cease the listening on the frequency on which the distress message was received and, if possible, any other frequency that may be used by the station in distress.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": false}
          ]
        },
        {
          "question_id": "5.13",
          "question_text": "According to transmission of numbers, \"126.7\" is pronounced as:",
          "options": [
            {"id": 1, "text": "one two six seven", "correct": false},
            {"id": 2, "text": "one hundred twenty six seven", "correct": false},
            {"id": 3, "text": "one two six decimal seven", "correct": true},
            {"id": 4, "text": "one two six point seven", "correct": false}
          ]
        },
        {
          "question_id": "5.14",
          "question_text": "According to transmission of numbers, \"200\" is pronounced as:",
          "options": [
            {"id": 1, "text": "two double zero", "correct": false},
            {"id": 2, "text": "two zero zero", "correct": true},
            {"id": 3, "text": "two hundred", "correct": false},
            {"id": 4, "text": "two and hundred", "correct": false}
          ]
        },
        {
          "question_id": "5.15",
          "question_text": "When using a radio, you should:",
          "options": [
            {"id": 1, "text": "Speak very loudly.", "correct": false},
            {"id": 2, "text": "Speak all words plainly and clearly.", "correct": true},
            {"id": 3, "text": "Speak rapidly.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": false}
          ]
        },
        {
          "question_id": "5.16",
          "question_text": "Operators hearing a call directed to their station may reply that he/she is not ready before two minutes with the word(s):",
          "options": [
            {"id": 1, "text": "STAND BY", "correct": false},
            {"id": 2, "text": "STAND BY TWO MINUTES", "correct": true},
            {"id": 3, "text": "WAIT", "correct": false},
            {"id": 4, "text": "WAIT TWO MINUTES", "correct": false}
          ]
        },
        {
          "question_id": "5.17",
          "question_text": "In communications between stations, if the station called is not in agreement with the calling station on the working frequency or channel to be used, it shall:",
          "options": [
            {"id": 1, "text": "Answer by \"ROGER\".", "correct": false},
            {"id": 2, "text": "The station called must always agree with the calling station indications.", "correct": false},
            {"id": 3, "text": "Transmit an indication of the working frequency or channel to be used.", "correct": true},
            {"id": 4, "text": "Advise the appropriate FSS.", "correct": false}
          ]
        },
        {
          "question_id": "5.18",
          "question_text": "What word or expression would be used to indicate a transmission error has been made?",
          "options": [
            {"id": 1, "text": "Correction.", "correct": true},
            {"id": 2, "text": "Mistake.", "correct": false},
            {"id": 3, "text": "That is wrong.", "correct": false},
            {"id": 4, "text": "None of the above.", "correct": false}
          ]
        },
        {
          "question_id": "5.19",
          "question_text": "The term \"AFFIRMATIVE\" means:",
          "options": [
            {"id": 1, "text": "I request permission to.", "correct": false},
            {"id": 2, "text": "I agree, but please repeat.", "correct": false},
            {"id": 3, "text": "Yes, or permission granted.", "correct": true},
            {"id": 4, "text": "Please confirm, I do not understand.", "correct": false}
          ]
        },
        {
          "question_id": "5.20",
          "question_text": "In the ITU phonetic alphabet, \"0\" is pronounced as:",
          "options": [
            {"id": 1, "text": "ZE-ro", "correct": false},
            {"id": 2, "text": "ze-RO", "correct": false},
            {"id": 3, "text": "ZE-RO", "correct": true},
            {"id": 4, "text": "ze-ro", "correct": false}
          ]
        },
        {
          "question_id": "5.21",
          "question_text": "If you hear a distress call in flight, you have to:",
          "options": [
            {"id": 1, "text": "Cease any transmission capable of interfering with distress traffic.", "correct": true},
            {"id": 2, "text": "Call 911 to report the distress condition.", "correct": false},
            {"id": 3, "text": "Change frequency not to interfere with the distress traffic.", "correct": false},
            {"id": 4, "text": "All of the above.", "correct": false}
          ]
        },
        {
          "question_id": "5.22",
          "question_text": "Canadian private aircraft use ____ as a call sign.",
          "options": [
            {"id": 1, "text": "The aircraft's color and model number", "correct": false},
            {"id": 2, "text": "The manufacturer's name or their type of aircraft, followed by the last four letters of the registration", "correct": true},
            {"id": 3, "text": "The pilot's name and flight number", "correct": false},
            {"id": 4, "text": "The airport code and flight number", "correct": false}
          ]
        },
        {
          "question_id": "5.23",
          "question_text": "Any person who violates the regulations relative to unauthorized communications, profane or obscene language is liable, on summary conviction, in the case of an individual, to imprisonment for a ---- term of ---- year(s).",
          "options": [
            {"id": 1, "text": "Minimum; 1.", "correct": false},
            {"id": 2, "text": "Maximum; 1.", "correct": true},
            {"id": 3, "text": "Maximum; 3.", "correct": false},
            {"id": 4, "text": "Minimum; 3.", "correct": false}
          ]
        },
        {
          "question_id": "5.24",
          "question_text": "In flight, you intercept a weather report or a storm warning. Can you relay this message?",
          "options": [
            {"id": 1, "text": "Yes.", "correct": true},
            {"id": 2, "text": "Yes, if you have the clearance from the transmitting station.", "correct": false},
            {"id": 3, "text": "Yes, but only if the safety of other aircraft is compromised", "correct": false},
            {"id": 4, "text": "No.", "correct": false}
          ]
        },
        {
          "question_id": "5.25",
          "question_text": "An individual who violates the privacy of communications is liable to a ---- fine of ---- dollars and to imprisonment for a ---- term of ----",
          "options": [
            {"id": 1, "text": "Maximum; 75,000; maximum; 3 years.", "correct": false},
            {"id": 2, "text": "Minimum; 15,000; minimum; 1 year.", "correct": false},
            {"id": 3, "text": "Maximum; 25,000; maximum; 1 year.", "correct": true},
            {"id": 4, "text": "Minimum; 75,000; minimum; 3 years.", "correct": false}
          ]
        }
      ]
    },
    {
      "section_code": "6.0",
      "section_title": "Practice Exam 6",
      "comment": "https://ised-isde.canada.ca/site/spectrum-management-telecommunications/sites/default/files/attachments/2022/ric21-upd-oct-2011.pdf",
      "questions": [
        {
          "question_id": "6.01",
          "question_text": "The document on which your radio station call sign and authorized frequencies can be found is:",
          "options": [
            {"id": 1, "text": "The Radiotelephone Operators Handbook.", "correct": false},
            {"id": 2, "text": "Radio station licence", "correct": true},
            {"id": 3, "text": "Radio log book.", "correct": false},
            {"id": 4, "text": "The radio equipment owner's manual.", "correct": false}
          ]
        },
        {
          "question_id": "6.02",
          "question_text": "Conversations heard over the air:",
          "options": [
            {"id": 1, "text": "Must be identified in English only.", "correct": false},
            {"id": 2, "text": "Must not exceed two minutes in length.", "correct": false},
            {"id": 3, "text": "Are to be treated as strictly confidential.", "correct": true},
            {"id": 4, "text": "Should be relayed to others who may be interested.", "correct": false}
          ]
        },
        {
          "question_id": "6.03",
          "question_text": "Radio equipment eligible for licensing in Canada must be:",
          "options": [
            {"id": 1, "text": "Certified by Industry Canada.", "correct": true},
            {"id": 2, "text": "C.S.A. approved.", "correct": false},
            {"id": 3, "text": "Made in Canada.", "correct": false},
            {"id": 4, "text": "F.C.C. approved.", "correct": false}
          ]
        },
        {
          "question_id": "6.04",
          "question_text": "What would a readability of 5 mean?",
          "options": [
            {"id": 1, "text": "Good (or readable).", "correct": false},
            {"id": 2, "text": "Poor (or readable now and then).", "correct": false},
            {"id": 3, "text": "Bad (or unreadable).", "correct": false},
            {"id": 4, "text": "Excellent (or Perfectly readable).", "correct": true}
          ]
        },
        {
          "question_id": "6.05",
          "question_text": "In the case of normal communications between a base station and an aircraft station:",
          "options": [
            {"id": 1, "text": "The aircraft station cannot call the base station first.", "correct": false},
            {"id": 2, "text": "The aircraft station has control of communications.", "correct": false},
            {"id": 3, "text": "Whichever station called first has control of communications.", "correct": false},
            {"id": 4, "text": "The base station has control of communications.", "correct": true}
          ]
        },
        {
          "question_id": "6.06",
          "question_text": "Generally speaking, before making any radio transmission you should:",
          "options": [
            {"id": 1, "text": "Make a test transmission.", "correct": false},
            {"id": 2, "text": "Listen first to ensure that the channel is clear.", "correct": true},
            {"id": 3, "text": "Transmit the signal \"BREAK\" \"BREAK\".", "correct": false},
            {"id": 4, "text": "Adjust the gain control to maximum.", "correct": false}
          ]
        },
        {
          "question_id": "6.07",
          "question_text": "Signal checks should:",
          "options": [
            {"id": 1, "text": "Not last more than 10 seconds.", "correct": true},
            {"id": 2, "text": "Be exchanged on channel 16.", "correct": false},
            {"id": 3, "text": "Last as long as the operator wishes.", "correct": false},
            {"id": 4, "text": "Be exchanged on channel 16 and last as long as the operator wishes.", "correct": false}
          ]
        },
        {
          "question_id": "6.08",
          "question_text": "The International VHF aeronautical air-ground distress frequency is:",
          "options": [
            {"id": 1, "text": "121.5 MHz.", "correct": true},
            {"id": 2, "text": "122.2 MHZ.", "correct": false},
            {"id": 3, "text": "121.9 MHz.", "correct": false},
            {"id": 4, "text": "156.8 MHz.", "correct": false}
          ]
        },
        {
          "question_id": "6.09",
          "question_text": "Assuming your aircraft registration is C-FGAC, how would you call another aircraft whose call sign is C-CBRD?",
          "options": [
            {"id": 1, "text": "CHARLIE FOXTROT GOLF ALPHA CHARLIE to CHARLIE CHARLIE BRAVO ROMEO DELTA over", "correct": false},
            {"id": 2, "text": "CHARLIE CHARLIE BRAVO ROMEO DELTA this is CHARLIE FOXTROT GOLF ALPHA CHARLIE over", "correct": true},
            {"id": 3, "text": "FOXTROT GOLF ALPHA CHARLIE come in please over", "correct": false},
            {"id": 4, "text": "FGAC how do you read me over", "correct": false}
          ]
        },
        {
          "question_id": "6.10",
          "question_text": "The signal \"PAN PAN\" spoken three times indicates:",
          "options": [
            {"id": 1, "text": "A safety situation.", "correct": false},
            {"id": 2, "text": "A distress situation", "correct": false},
            {"id": 3, "text": "An urgency situation.", "correct": true},
            {"id": 4, "text": "An imposition of silence.", "correct": false}
          ]
        },
        {
          "question_id": "6.11",
          "question_text": "The figures 600 would be transmitted as:",
          "options": [
